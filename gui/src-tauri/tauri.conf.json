{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixLink",
  "mainBinaryName": "mixlink-gui",
  "version": "0.1.0",
  "identifier": "dev.mixlink.gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MixLink",
        "width": 900,
        "height": 560,
        "minWidth": 720,
        "minHeight": 460,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
